{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ymoverlay",
  "version": "0.1.0",
  "identifier": "com.ymoverlay.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "YouTube Music",
        "url": "https://music.youtube.com",
        "width": 1200,
        "height": 800,
        "visible": true,
        "skipTaskbar": false,
        "focus": false,
        "devtools": true
      },
      {
        "label": "overlay",
        "title": "Overlay",
        "url": "index.html",
        "width": 360,
        "height": 620,
        "minWidth": 360,
        "minHeight": 380,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "center": true,
        "devtools": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
