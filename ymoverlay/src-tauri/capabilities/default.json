{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Local overlay permissions. Only this window can invoke application commands; remote player pages receive event permissions separately.",
  "windows": [
    "overlay"
  ],
  "permissions": [
    "allow-ytm-eval",
    "allow-spotify-eval",
    "allow-get-player-state",
    "allow-toggle-music-window",
    "allow-select-player",
    "allow-set-overlay-pinned",
    "core:default",
    "core:window:allow-set-size",
    "core:window:allow-start-dragging"
  ]
}
